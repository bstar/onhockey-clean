{
  "name": "onhockey-clean",
  "productName": "OnHockey Clean",
  "version": "0.1.0",
  "description": "A quiet, NHL-first hockey stream desktop app",
  "main": "electron/main.cjs",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop.cjs",
    "build": "electron-builder --linux dir",
    "appimage": "electron-builder --linux AppImage",
    "test:layout": "node tests/layout.cjs",
    "test:refresh": "node tests/refresh.cjs"
  },
  "build": {
    "appId": "local.onhockey.clean",
    "files": [
      "electron/**/*",
      "lib/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY.md",
      "README.md"
    ],
    "linux": {
      "category": "AudioVideo",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ],
      "executableName": "onhockey-clean",
      "syncDesktopName": true
    },
    "artifactName": "OnHockey-Clean-${version}.${ext}"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "cheerio": "^1.2.0",
    "hls.js": "^1.7.3"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.1"
  },
  "author": "OnHockey Clean contributors",
  "desktopName": "onhockey-clean.desktop"
}
